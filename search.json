---
layout: null
permalink: /search.json
sitemap: false
---
{%- comment -%}
  Build-time search index for the command palette and /search/ page.
  Fetched lazily (only when the user opens search), so it never touches LCP.
  Ranking in palette.js: title > tags > excerpt > body.
{%- endcomment -%}
[
{%- for post in site.posts -%}
{
  "title": {{ post.title | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "tags": {{ post.tags | jsonify }},
  "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 220 | jsonify }},
  "body": {{ post.content | strip_html | strip_newlines | truncate: 4000 | jsonify }}
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
